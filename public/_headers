/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Wire format for the homepage search box, not a page. It is fetched by script
# rather than linked, but Googlebot runs that fetch, and a 300 KB JSON blob has
# no business in an index. The URL carries ?v=<release date>, so a new dataset
# produces a new cache key and the long max-age never serves stale results.
/search-index.json
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=31536000, immutable

# Same deal: the social card is requested as /og.png?v=<release date>, so the
# cache key turns over with the dataset.
/og.png
  Cache-Control: public, max-age=31536000, immutable

# Markdown served as plain text, per the llms.txt convention. Cloudflare infers
# text/plain from the extension but the charset is what matters here: the file
# is full of accented French, and a client left to guess renders it as mojibake.
/llms.txt
  Content-Type: text/plain; charset=utf-8

# HSTS carries no `preload`: that one is a one-way door, and submitting the apex
# before www exists and serves HTTPS would strand it.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
