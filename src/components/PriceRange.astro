---
// Spread of prices per sqm. Deciles are never shown raw: the band carries the
// shape, the sentence carries the reading. One single-hue ramp per type,
// ordered from decile to quartile, with the median as a solid tick.
import { agree, formatPricePerSqm, TYPE_LABELS } from '../lib/format.js'

const { commune, types } = Astro.props

const SERIES_COLOR = {
  apartment: 'var(--color-series-apartment)',
  house: 'var(--color-series-house)',
}

const bands = types.map((type) => {
  const block = commune.recent[type]
  const span = block.d9 - block.d1
  // A zero spread is theoretical; the division by zero it causes is not.
  const position = (value) => (span > 0 ? ((value - block.d1) / span) * 100 : 50)
  return {
    type,
    block,
    color: SERIES_COLOR[type],
    label: TYPE_LABELS[type],
    e: agree(type),
    q1: position(block.q1),
    q3: position(block.q3),
    median: position(block.pricePerSqm),
  }
})
---

<section class="my-14">
  <h2 class="text-xl font-semibold">Fourchette de prix</h2>
  <p class="mt-1 text-sm text-ink-secondary">
    La médiane seule ne dit rien de l'écart entre les ventes. Voici comment les prix se répartissent.
  </p>

  <div class="mt-5 space-y-7">
    {
      bands.map((band) => (
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-sm font-medium">{band.label.title}</h3>
            <p class="text-sm text-ink-secondary">
              Médiane <span class="font-medium text-ink tabular">{formatPricePerSqm(band.block.pricePerSqm)}</span>
            </p>
          </div>

          <div class="relative mt-3 h-6" aria-hidden="true">
            <div
              class="absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 rounded-full"
              style={`background:color-mix(in oklab, ${band.color} 18%, var(--color-surface))`}
            />
            <div
              class="absolute top-1/2 h-3.5 -translate-y-1/2 rounded-full"
              style={`left:${band.q1}%;width:${band.q3 - band.q1}%;background:color-mix(in oklab, ${band.color} 42%, var(--color-surface))`}
            />
            <div
              class="absolute top-1/2 h-6 w-0.5 -translate-x-1/2 -translate-y-1/2 rounded-full"
              style={`left:${band.median}%;background:${band.color}`}
            />
          </div>

          <div class="mt-1.5 flex justify-between text-xs text-ink-muted tabular">
            <span>{formatPricePerSqm(band.block.d1)}</span>
            <span>{formatPricePerSqm(band.block.d9)}</span>
          </div>

          <p class="mt-3 text-sm text-ink-secondary">
            La moitié des {band.label.plural} se sont vendu{band.e}s entre{' '}
            <span class="font-medium text-ink tabular">{formatPricePerSqm(band.block.q1)}</span> et{' '}
            <span class="font-medium text-ink tabular">{formatPricePerSqm(band.block.q3)}</span>.{' '}
            {band.label.feminine ? 'Une' : 'Un'} sur dix est parti{band.e} sous{' '}
            <span class="font-medium text-ink tabular">{formatPricePerSqm(band.block.d1)}</span>,{' '}
            {band.label.article} sur dix au-dessus de{' '}
            <span class="font-medium text-ink tabular">{formatPricePerSqm(band.block.d9)}</span>.
          </p>
        </div>
      ))
    }
  </div>

  <p class="mt-6 rounded-lg border border-brand-200 bg-brand-100 px-4 py-3 text-sm text-ink-secondary">
    Les DVF ne disent rien de l'état du bien, de son étage ni de son exposition. Un prix bas dans
    cette fourchette a presque toujours une raison — travaux à prévoir, rez-de-chaussée, vente
    entre proches.
  </p>
</section>
