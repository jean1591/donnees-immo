---
// Median price per sqm by year and property type. Two series at most, so a
// two-slot categorical palette (validated against the cream surface).
// The table below the chart is its accessible twin: no value is reachable
// through hover alone.
import { formatCount, formatPricePerSqm } from '../lib/format.js'
import { TYPE_LABELS } from '../lib/format.js'

// `labels` overrides the legend when the series is not the whole property type —
// a room-count page plots one typology, and calling its line « Appartements »
// would name a market ten times larger than the one drawn.
// `subject` names what the lines split on, for the image's alternative text.
//
// `volume` adds the yearly sale count as bars behind the line, on its own axis.
// Two scales in one frame invite a comparison neither supports, so the bars are
// kept subordinate on every axis that carries meaning: they sit behind, they are
// the only thing anchored to zero — a count has a zero, a price level does not —
// and they take a neutral tone rather than a third series colour, which would
// read as a third market. Orange stays apartments and blue stays houses.
const { yearly, types, labels = {}, subject = 'type de bien', volume = null } = Astro.props

const bars = volume?.length ? volume : null

const WIDTH = 720
const HEIGHT = 280
// The right margin holds the endpoint label; with bars it also holds their axis,
// which is why it widens rather than letting the two land on each other.
const PAD = { top: 16, right: bars ? 118 : 84, bottom: 36, left: 60 }
const PLOT = {
  width: WIDTH - PAD.left - PAD.right,
  height: HEIGHT - PAD.top - PAD.bottom,
}

const VOLUME_COLOR = 'var(--color-baseline)'

const SERIES_COLOR = {
  apartment: 'var(--color-series-apartment)',
  house: 'var(--color-series-house)',
}

const years = yearly.map((entry) => entry.year)
const values = yearly.flatMap((entry) =>
  types.map((type) => entry[type]?.pricePerSqm).filter(Boolean)
)

// Y scale on nice steps (1/2/5 × 10^n). A price-level line doesn't have to
// start at zero, but the ticks still have to read cleanly.
const niceStep = (span, target) => {
  const raw = span / target
  const magnitude = 10 ** Math.floor(Math.log10(raw))
  const normalized = raw / magnitude
  const factor = normalized <= 1 ? 1 : normalized <= 2 ? 2 : normalized <= 5 ? 5 : 10
  return factor * magnitude
}

const rawMin = Math.min(...values)
const rawMax = Math.max(...values)
const step = niceStep(rawMax - rawMin || rawMax * 0.2, 4)
const yMin = Math.floor(rawMin / step) * step - (rawMin % step === 0 ? step : 0)
const yMax = Math.ceil(rawMax / step) * step

const ticks = []
for (let value = yMin; value <= yMax + 1; value += step) ticks.push(value)

const x = (year) =>
  PAD.left +
  (years.length === 1 ? PLOT.width / 2 : (years.indexOf(year) / (years.length - 1)) * PLOT.width)
const y = (value) => PAD.top + PLOT.height - ((value - yMin) / (yMax - yMin)) * PLOT.height

// Counts start at zero and are read against three ticks: enough to size a bar,
// few enough that the right-hand axis never competes with the price axis for
// attention. The bars are context, not the subject of the chart.
const volumeMax = bars ? Math.max(...bars.map((entry) => entry.count)) : 0
const volumeStep = volumeMax ? niceStep(volumeMax, 2) : 0
const volumeTop = volumeMax ? Math.ceil(volumeMax / volumeStep) * volumeStep : 0
// Guarded on the step, not on `bars`: without volume the step is 0, and a loop
// incrementing by 0 never reaches its bound — it pushes until the array refuses
// to grow, which is what took the commune pages down.
const volumeTicks = []
if (volumeStep > 0) {
  for (let value = volumeStep; value <= volumeTop + 1; value += volumeStep) volumeTicks.push(value)
}

// Half the slot, so neighbouring bars never touch: a gap says « five separate
// years » where a continuous block would say « one distribution ».
const barWidth = bars ? (PLOT.width / Math.max(years.length, 1)) * 0.5 : 0
const barHeight = (count) => (volumeTop ? (count / volumeTop) * PLOT.height : 0)

// A year without a median breaks the path instead of bridging the gap, which
// would imply a continuity that was never measured.
const series = types.map((type) => {
  const points = yearly
    .map((entry) => ({ year: entry.year, value: entry[type]?.pricePerSqm }))
    .map((point) => (point.value ? { ...point, x: x(point.year), y: y(point.value) } : null))

  const segments = []
  let current = []
  for (const point of points) {
    if (point) current.push(point)
    else if (current.length) (segments.push(current), (current = []))
  }
  if (current.length) segments.push(current)

  const drawn = points.filter(Boolean)
  return {
    type,
    color: SERIES_COLOR[type],
    label: labels[type] ?? TYPE_LABELS[type].title,
    points: drawn,
    last: drawn.at(-1),
    paths: segments
      .filter((segment) => segment.length > 1)
      .map((segment) => segment.map((p, i) => `${i ? 'L' : 'M'}${p.x} ${p.y}`).join(' ')),
  }
})

// Two endpoint labels that land too close would overlap: nudge them apart.
const labelled = series.filter((s) => s.last)
if (labelled.length === 2 && Math.abs(labelled[0].last.y - labelled[1].last.y) < 18) {
  const [upper, lower] = [...labelled].sort((a, b) => a.last.y - b.last.y)
  upper.labelY = Math.min(upper.last.y, lower.last.y) - 9
  lower.labelY = Math.max(upper.last.y, lower.last.y) + 9
}
for (const s of labelled) s.labelY ??= s.last.y
---

<figure class="my-14">
  <figcaption class="mb-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h2 class="text-xl font-semibold">Évolution du prix médian au m²</h2>
    <ul class="flex gap-4 text-xs text-ink-secondary">
      {
        series.map((s) => (
          <li class="flex items-center gap-1.5">
            <span
              class="inline-block h-2 w-2 shrink-0 rounded-full"
              style={`background:${s.color}`}
              aria-hidden="true"
            />
            {s.label}
          </li>
        ))
      }
      {
        bars && (
          /* A square against the series' dots: the shape carries the difference
             between a bar and a line even where the two tones do not. */
          <li class="flex items-center gap-1.5">
            <span
              class="inline-block h-2 w-2 shrink-0 rounded-[1px]"
              style={`background:${VOLUME_COLOR}`}
              aria-hidden="true"
            />
            Ventes
          </li>
        )
      }
    </ul>
  </figcaption>

  <div class="overflow-x-auto rounded-lg border border-hairline bg-surface p-2">
    <svg
      viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
      class="h-auto w-full min-w-[480px]"
      role="img"
      aria-label={`Prix médian au mètre carré de ${years[0]} à ${years.at(-1)}, par ${subject}${bars ? ', et nombre de ventes par année' : ''}. Les valeurs sont reprises dans le tableau qui suit.`}
    >
      {
        ticks.map((tick) => (
          <line
            x1={PAD.left}
            x2={WIDTH - PAD.right}
            y1={y(tick)}
            y2={y(tick)}
            stroke="var(--color-hairline)"
            stroke-width="1"
          />
        ))
      }

      {
        bars &&
          bars.map((entry) => (
            <rect
              x={x(entry.year) - barWidth / 2}
              y={PAD.top + PLOT.height - barHeight(entry.count)}
              width={barWidth}
              height={barHeight(entry.count)}
              rx="2"
              fill={VOLUME_COLOR}
              opacity="0.55"
            >
              <title>{`${entry.year} : ${formatCount(entry.count)} ventes`}</title>
            </rect>
          ))
      }

      {/* Axis labels are painted after the bars, not with their gridlines: an
          edge bar reaches under the label column, and a tick a reader cannot
          make out costs more than a bar drawn over. */}
      {
        ticks.map((tick) => (
          <text
            x={PAD.left - 10}
            y={y(tick)}
            text-anchor="end"
            dominant-baseline="middle"
            fill="var(--color-ink-muted)"
            style="font-size:12px;font-variant-numeric:tabular-nums"
          >
            {tick.toLocaleString('fr-FR')}
          </text>
        ))
      }

      {
        bars &&
          volumeTicks.map((tick) => (
            <text
              x={WIDTH - 6}
              y={PAD.top + PLOT.height - barHeight(tick)}
              text-anchor="end"
              dominant-baseline="middle"
              fill="var(--color-ink-muted)"
              style="font-size:11px;font-variant-numeric:tabular-nums"
            >
              {tick.toLocaleString('fr-FR')}
            </text>
          ))
      }

      <line
        x1={PAD.left}
        x2={WIDTH - PAD.right}
        y1={PAD.top + PLOT.height}
        y2={PAD.top + PLOT.height}
        stroke="var(--color-baseline)"
        stroke-width="1"></line>

      {
        years.map((year) => (
          <text
            x={x(year)}
            y={HEIGHT - 12}
            text-anchor="middle"
            fill="var(--color-ink-muted)"
            style="font-size:12px;font-variant-numeric:tabular-nums"
          >
            {year}
          </text>
        ))
      }

      {
        series.map((s) => (
          <g>
            {s.paths.map((d) => (
              <path
                d={d}
                fill="none"
                stroke={s.color}
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            ))}
            {s.points.map((point) => (
              <circle cx={point.x} cy={point.y} r="4.5" fill={s.color} stroke="var(--color-surface)" stroke-width="2">
                <title>{`${s.label} — ${point.year} : ${formatPricePerSqm(point.value)}`}</title>
              </circle>
            ))}
          </g>
        ))
      }

      {
        labelled.map((s) => (
          <text
            x={s.last.x + 12}
            y={s.labelY}
            dominant-baseline="middle"
            fill="var(--color-ink-secondary)"
            style="font-size:12px;font-weight:600;font-variant-numeric:tabular-nums"
          >
            {formatPricePerSqm(s.last.value)}
          </text>
        ))
      }
    </svg>
  </div>

  <p class="mt-2 text-xs text-ink-muted">
    Médiane annuelle, en euros par mètre carré, sur l'axe de gauche.
    {
      bars &&
        ' Les barres donnent le nombre de ventes de l’année, sur l’axe de droite : elles disent sur combien de ventes la médiane est calculée, pas si les prix montent.'
    }
    {' '}Les valeurs exactes et le nombre de ventes figurent dans le tableau ci-dessous.
  </p>
</figure>
