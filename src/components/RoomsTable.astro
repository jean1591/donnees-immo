---
// Median price by room count, over 24 months. Both the total price and the
// price per sqm are shown: readers work out the ratio themselves otherwise,
// and dividing one median by the other does not give the median of the ratios
// — off by ~3 % on a Bordeaux two-room flat, which is why the ETL computes it.
import {
  formatArea,
  formatCount,
  formatEuro,
  formatPricePerSqm,
  roomLabel,
  TYPE_LABELS,
} from '../lib/format.js'

const { rooms, types } = Astro.props
const tables = types.filter((type) => rooms[type].length > 0)
---

{
  tables.length > 0 && (
    <section class="my-14">
      <h2 class="text-xl font-semibold">Prix par nombre de pièces</h2>
      <p class="mt-2 text-sm text-ink-secondary">
        Médianes sur les 24 derniers mois. Le nombre de ventes indique le poids de chaque ligne.
      </p>

      <div class="mt-6 space-y-8">
        {tables.map((type) => (
          <div class="overflow-x-auto rounded-lg border border-hairline bg-surface">
            <table class="w-full text-sm">
              <caption class="border-b border-hairline px-4 py-3 text-left text-sm font-semibold">
                {TYPE_LABELS[type].title}
              </caption>
              <thead class="bg-surface-sunk text-xs text-ink-secondary">
                <tr>
                  <th scope="col" class="px-4 py-2.5 text-left font-medium">
                    Type
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Prix de vente
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Prix au m²
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Surface
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Ventes
                  </th>
                </tr>
              </thead>
              <tbody>
                {rooms[type].map((row) => (
                  <tr class="border-t border-hairline">
                    <th scope="row" class="px-4 py-2.5 text-left font-medium">
                      {roomLabel(row.rooms, type)}
                    </th>
                    <td class="px-4 py-2.5 text-right">{formatEuro(row.medianPrice)}</td>
                    <td class="px-4 py-2.5 text-right">{formatPricePerSqm(row.pricePerSqm)}</td>
                    <td class="px-4 py-2.5 text-right text-ink-secondary">
                      {formatArea(row.medianArea)}
                    </td>
                    <td class="px-4 py-2.5 text-right text-ink-secondary">
                      {formatCount(row.count)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </section>
  )
}
