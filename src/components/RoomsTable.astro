---
// Median price by room count, over 24 months. Both the total price and the
// price per sqm are shown: readers work out the ratio themselves otherwise,
// and dividing one median by the other does not give the median of the ratios
// — off by ~3 % on a Bordeaux two-room flat, which is why the ETL computes it.
import {
  formatArea,
  formatCount,
  formatEuro,
  formatPricePerSqm,
  roomLabel,
  TYPE_LABELS,
} from '../lib/format.js'
import { hasRoomPage, roomPagePath } from '../lib/rooms.js'
import { RECENT_WINDOW } from '../lib/dataset.js'
import RowLinks from './RowLinks.astro'

// `commune` is optional: without it the table is a table. With it, the rows that
// have a page of their own link to it — which is the only inbound link those
// pages get, and the commune page is where a reader asking about a T3 already is.
const { rooms, types, commune } = Astro.props
const tables = types.filter((type) => rooms[type].length > 0)

const link = (type, row) =>
  commune && type === 'apartment' && hasRoomPage(commune, row.rooms)
    ? roomPagePath(commune, row.rooms)
    : null
---

{
  tables.length > 0 && (
    <section class="my-14">
      <h2 class="text-xl font-semibold">Prix par nombre de pièces</h2>
      <p class="mt-2 text-sm text-ink-secondary">
        Médianes sur les ventes {RECENT_WINDOW.prose}. Le nombre de ventes indique le poids de
        chaque ligne.
        {commune && ' Les typologies en orange ouvrent une page détaillée : surface, fourchette de prix, évolution.'}
      </p>

      <div class="mt-6 space-y-8">
        {tables.map((type) => (
          <div class="overflow-x-auto rounded-lg border border-hairline bg-surface">
            <table class="w-full text-sm">
              <caption class="border-b border-hairline px-4 py-3 text-left text-sm font-semibold">
                {TYPE_LABELS[type].title}
              </caption>
              <thead class="bg-surface-sunk text-xs text-ink-secondary">
                <tr>
                  <th scope="col" class="px-4 py-2.5 text-left font-medium">
                    Type
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Prix de vente
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Prix au m²
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Surface
                  </th>
                  <th scope="col" class="px-4 py-2.5 text-right font-medium">
                    Ventes
                  </th>
                </tr>
              </thead>
              <tbody>
                {rooms[type].map((row) => (
                  /* A linked row is signalled three ways — brand colour, an
                     arrow, and a tint under the whole row on hover — because in
                     a table of numbers an underlined label alone reads as
                     emphasis rather than as somewhere to go. */
                  <tr
                    data-href={link(type, row) ?? undefined}
                    class:list={[
                      'border-t border-hairline transition-colors',
                      link(type, row) && 'cursor-pointer hover:bg-brand-100',
                    ]}
                  >
                    <th scope="row" class="px-4 py-2.5 text-left font-medium">
                      {link(type, row) ? (
                        <a
                          class="inline-flex items-center gap-1 font-semibold text-brand-600 underline decoration-brand-300 underline-offset-2 hover:text-brand-700 hover:decoration-brand-500"
                          href={link(type, row)}
                        >
                          {roomLabel(row.rooms, type)}
                          {/* The arrow inherits the underline: a child cannot
                              cancel a decoration its parent draws through it. */}
                          <span aria-hidden="true" class="text-xs">→</span>
                        </a>
                      ) : (
                        roomLabel(row.rooms, type)
                      )}
                    </th>
                    <td class="px-4 py-2.5 text-right">{formatEuro(row.medianPrice)}</td>
                    <td class="px-4 py-2.5 text-right">{formatPricePerSqm(row.pricePerSqm)}</td>
                    <td class="px-4 py-2.5 text-right text-ink-secondary">
                      {formatArea(row.medianArea)}
                    </td>
                    <td class="px-4 py-2.5 text-right text-ink-secondary">
                      {formatCount(row.count)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
    </section>
  )
}

{/* Only where a row actually links somewhere: the commune pages outside the
    room-count selection have no `data-href` to act on. */}
{commune && <RowLinks />}
