---
// The questions a page can answer, spelled out. Nothing is collapsed behind a
// disclosure widget: the whole point is that the answer is text on the page,
// readable by a crawler and quotable by a model without running anything.
const { items } = Astro.props
---

{
  items.length > 0 && (
    <section class="mt-14">
      <h2 class="text-xl font-semibold">Questions fréquentes</h2>
      <p class="mt-2 max-w-2xl text-sm text-ink-secondary">
        Les réponses reprennent les chiffres de cette page, sans arrondi supplémentaire.
      </p>

      <dl class="mt-6 max-w-2xl">
        {items.map((item) => (
          <div class="border-t border-hairline py-5 first:border-t-0 first:pt-0">
            <dt class="font-semibold">{item.question}</dt>
            <dd class="mt-2 leading-relaxed text-ink-secondary">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
