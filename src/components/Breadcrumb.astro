---
// Emits both the visible trail and its BreadcrumbList markup, so the two can
// never disagree — search results show the trail instead of a bare URL.
const { items } = Astro.props

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).href } : {}),
  })),
}
---

<nav aria-label="Fil d'ariane" class="text-xs text-ink-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a
              class="underline decoration-hairline underline-offset-2 hover:text-brand-600"
              href={item.href}
            >
              {item.label}
            </a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
