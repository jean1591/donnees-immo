---
// Department roll-up. The URL keeps an explicit `departement-` segment because
// several department names are also commune names (Vienne, Aube…), so a shared
// `/prix-immobilier-[slug]` route would collide.
import Base from '../layouts/Base.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import PriceChart from '../components/PriceChart.astro'
import StatTile from '../components/StatTile.astro'
import YearlyTable from '../components/YearlyTable.astro'
import Faq from '../components/Faq.astro'
import { departmentRank, departments, gapToNational, national } from '../lib/departments.js'
import { isRankable, publishedTypes, rankByEvolution, yearlyVolume } from '../lib/communes.js'
import { DATASET, place, publisher, RECENT_WINDOW } from '../lib/dataset.js'
import { buildDepartmentFaq } from '../lib/faq.js'
import {
  agree,
  formatCount,
  formatEuro,
  formatPercent,
  formatPercentMagnitude,
  formatPricePerSqm,
  formatPricePerSqmProse,
  plural,
  TYPE_LABELS,
} from '../lib/format.js'

export function getStaticPaths() {
  return departments.map((department) => ({
    params: { slug: department.slug },
    props: { department },
  }))
}

const { department } = Astro.props
const communes = department.communes
const districts = department.districts

// Paris, Lyon and Marseille are one commune each in their own department, so
// the inventory has to name the arrondissements or the page describes itself
// as holding a single market.
const inventory = districts.length
  ? `${formatCount(communes.length)} ${plural(communes.length, 'commune')} et ${districts.length} arrondissements`
  : `${formatCount(communes.length)} ${plural(communes.length, 'commune')}`

// The department's own medians, recomputed from every sale it recorded — a
// wider base than the communes listed below, which is what makes this page
// worth more than the sum of its rows. Types are ordered by volume: the lead
// one carries the title, the description and the ranking sentence.
const types = publishedTypes(department)
const lead = types.length ? department.recent[types[0]] : null
const leadLabel = types.length ? TYPE_LABELS[types[0]] : null
const rank = types.length ? departmentRank(department.code, types[0]) : null
const gap = lead ? gapToNational(lead, types[0]) : null
const departmentSales = types.reduce((sum, type) => sum + department.recent[type].count, 0)

// Department names carry no gender or article in the dataset, so every
// generated sentence goes through « le département X » rather than guessing
// between « en Gironde », « dans le Rhône » and « aux Hauts-de-Seine ».
const titleBase = `Prix immobilier ${department.name} (${department.code})`
const titleWithPrice = lead ? `${titleBase} — ${formatPricePerSqm(lead.pricePerSqm)}` : titleBase
const title = titleWithPrice.length <= 60 ? titleWithPrice : `${titleBase}, ${inventory}`
const description = lead
  ? `Prix immobilier dans le département ${department.name} (${department.code}) : ${formatPricePerSqm(lead.pricePerSqm)} pour ${leadLabel.article} ${leadLabel.singular}, ${formatEuro(lead.medianPrice)} en prix de vente. Médianes sur ${formatCount(departmentSales)} ventes enregistrées (DVF).`
  : `Prix au m² des ${inventory} du département ${department.name} (${department.code}), calculé sur les ventes enregistrées entre 2021 et 2025. Source DVF.`

const cell = (commune, type) =>
  commune.recent[type].count ? formatPricePerSqm(commune.recent[type].pricePerSqm) : '—'

// Extremes are ranked within a single property type — mixing a house median
// into an apartment ranking would compare two different markets. Houses are
// published in more communes, so they are the default; apartments take over
// only where they cover more of the department.
// `isRankable` rather than a plain published check: in Guadeloupe and
// Martinique a handful of medians are drawn from mutations that are not sales
// at market price, and they would take first place in the department's own
// cheapest list exactly as they would nationally. The table below still shows
// them — this only governs which communes get ranked against each other.
const withType = (type) => communes.filter((commune) => isRankable(commune.recent[type]))
const rankingType = withType('house').length >= withType('apartment').length ? 'house' : 'apartment'
const ranked = [...withType(rankingType)].sort(
  (a, b) => b.recent[rankingType].pricePerSqm - a.recent[rankingType].pricePerSqm
)
// Below ten communes the "top 5" and "bottom 5" would overlap or cover the
// whole department, which tells the reader nothing.
const extremes =
  ranked.length >= 10
    ? {
        type: rankingType,
        // Plural noun, no article: it sits in a caption rather than a
        // sentence, which sidesteps gender and elision entirely.
        label: TYPE_LABELS[rankingType].plural,
        highest: ranked.slice(0, 5),
        lowest: ranked.slice(-5).reverse(),
      }
    : null

// Where prices moved, over one year. This is the query no competitor answers
// and no AI summary can improve on without the underlying data: it takes
// 3 630 medians to rank a department, not a paragraph of commentary.
//
// The pool is much smaller than the price ranking above — a commune has to hold
// 50 sales in both 2024 and 2025, not just over the 24-month window — so it
// covers 42 departments rather than all of them. Below ten communes the top and
// bottom five overlap and the section says nothing.
const byTrend = rankByEvolution(withType(rankingType), rankingType, 1)
const trends =
  byTrend.length >= 10
    ? {
        label: TYPE_LABELS[rankingType].plural,
        from: byTrend[0].from,
        to: byTrend[0].to,
        eligible: byTrend.length,
        rising: byTrend.slice(0, 5),
        falling: byTrend.slice(-5).reverse(),
      }
    : null

// The commune table is the substance of this page, and it is the one thing the
// markup did not describe: without it the page declares a breadcrumb and
// nothing else. Prices stay out of the ItemList — they belong to each commune's
// own Dataset markup, and repeating them here would state the same figure twice
// with no way to keep the two in step.
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Prix immobilier des communes du département ${department.name} (${department.code})`,
  description,
  numberOfItems: communes.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: communes.map((commune, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: commune.name,
    url: new URL(`/prix-immobilier-${commune.slug}`, Astro.site).href,
  })),
}

// The department now measures something of its own, so it carries a Dataset of
// its own — until this release the page declared a list of links and nothing
// else. Same shape as a commune's, with the wider base spelled out in
// `measurementTechnique`: these medians count sales the listed communes do not.
const dataset = lead && {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Prix immobilier — département ${department.name} (${department.code})`,
  description,
  license: DATASET.licenseUrl,
  creator: { '@type': 'GovernmentOrganization', name: 'DGFiP' },
  publisher: publisher(Astro.site),
  dateModified: DATASET.releaseDate,
  temporalCoverage: `${DATASET.firstYear}/${DATASET.lastYear}`,
  spatialCoverage: place(department.name, department.geo),
  isBasedOn: DATASET.sourceUrl,
  variableMeasured: types.map((type) => ({
    '@type': 'PropertyValue',
    name: `Prix médian au m² — ${TYPE_LABELS[type].plural}`,
    value: department.recent[type].pricePerSqm,
    unitText: 'EUR/m²',
    measurementTechnique: `Médiane sur ${formatCount(department.recent[type].count)} ventes du département, 24 mois glissants`,
  })),
}

// The rankings and the national gap are passed in rather than recomputed: the
// page already holds them, and a second computation could answer a question
// with a figure the blocks above contradict.
const faq = buildDepartmentFaq(department, { extremes, rank })

const faqLd = faq.length && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
}

const jsonLd = [dataset, itemList, faqLd].filter(Boolean)
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: department.name }]} />

  <h1 class="mt-5 text-3xl font-semibold sm:text-4xl">
    Prix immobilier — {department.name} ({department.code})
  </h1>

  {
    lead && (
      <p class="mt-5 max-w-2xl text-xl leading-relaxed">
        Dans le département {department.name}, {leadLabel.article} {leadLabel.singular} se vend{' '}
        <strong class="font-semibold">{formatEuro(lead.medianPrice)}</strong>, soit
        <strong class="font-semibold"> {formatPricePerSqmProse(lead.pricePerSqm)}</strong>.
      </p>
    )
  }

  {
    lead && (
      <p class="mt-4 max-w-2xl leading-relaxed text-ink-secondary">
        C'est la médiane des {formatCount(lead.count)} {leadLabel.plural} vendu{agree(types[0])}s
        {' '}{RECENT_WINDOW.between} dans l'ensemble du département.
        {gap !== null && Math.abs(gap) >= 0.01 && (
          <>
            {' '}Le mètre carré y est{' '}
            <strong class="font-medium text-ink">{formatPercentMagnitude(gap)}</strong>{' '}
            {gap > 0 ? 'plus cher' : 'moins cher'} qu'à l'échelle du pays, où la médiane s'établit à{' '}
            {formatPricePerSqm(national.recent[types[0]].pricePerSqm)}
            {rank && <> — {rank.rank}<sup>e</sup> département sur {rank.total}</>}.
          </>
        )}
      </p>
    )
  }

  <div class:list={['mt-10 grid gap-4', types.length > 1 && 'md:grid-cols-2']}>
    {types.map((type) => <StatTile commune={department} type={type} />)}
  </div>

  <p class="mt-4 max-w-2xl text-sm text-ink-muted">
    {
      lead ? (
        <>
          Ces médianes couvrent toutes les ventes du département, y compris celles des communes trop
          petites pour avoir leur propre page : {formatCount(lead.communes)} communes ont vu{' '}
          {`${leadLabel.article} ${leadLabel.singular}`} changer de mains, et {inventory}{' '}
          {communes.length + districts.length > 1 ? 'atteignent' : 'atteint'} les 50 ventes qu'il
          faut pour publier une médiane propre.
        </>
      ) : (
        <>
          <strong class="font-semibold text-ink">{inventory}</strong> de ce département{' '}
          {communes.length + districts.length > 1 ? 'comptent' : 'compte'} assez de ventes pour
          publier un prix médian fiable sur les 24 derniers mois.
        </>
      )
    }
  </p>

  {
    department.yearly.length > 1 && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold">Cinq ans de prix dans le département</h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-secondary">
          Médiane annuelle du prix au m² sur l'ensemble des ventes du département, de{' '}
          {DATASET.firstYear} à {DATASET.lastYear}. Les barres donnent le nombre de ventes de
          l'année : une médiane calculée sur peu de ventes se déplace pour des raisons qui tiennent
          à l'échantillon.
        </p>
        <PriceChart
          yearly={department.yearly}
          types={types}
          volume={yearlyVolume(department)}
          subject="type de bien"
        />
        <YearlyTable yearly={department.yearly} types={types} />
      </section>
    )
  }

  {
    extremes && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold">Les écarts de prix dans le département</h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-secondary">
          Prix médian au m² des {extremes.label}, le type de bien publié dans le plus de communes
          du département. Comparer une médiane maison à une médiane appartement reviendrait à
          classer deux marchés différents.
        </p>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
        {[
          { heading: 'Les communes les plus chères', list: extremes.highest },
          { heading: 'Les communes les plus abordables', list: extremes.lowest },
        ].map((block) => (
          <div class="rounded-xl border border-hairline bg-surface p-6">
            <h3 class="text-base font-semibold">{block.heading}</h3>
            <ol class="mt-4 space-y-1">
              {block.list.map((commune) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-hairline py-2 text-sm last:border-0">
                  <a
                    class="font-medium underline decoration-brand-300 underline-offset-4 hover:text-brand-600"
                    href={`/prix-immobilier-${commune.slug}`}
                  >
                    {commune.name}
                  </a>
                  <span class="shrink-0 text-ink-secondary tabular">
                    {formatPricePerSqm(commune.recent[extremes.type].pricePerSqm)}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))}
        </div>

        <p class="mt-4 text-sm">
          <a
            class="underline decoration-brand-300 underline-offset-2 hover:text-brand-600"
            href="/villes-les-plus-cheres-de-france"
          >
            Voir le classement national des communes les plus chères
          </a>
        </p>
      </section>
    )
  }

  {
    trends && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold">
          Où les prix ont bougé entre {trends.from} et {trends.to}
        </h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-secondary">
          Variation du prix médian au m² des {trends.label}, sur les {trends.eligible} communes du
          département comptant au moins 50 ventes en {trends.from} comme en {trends.to}. En deçà, la
          variation d'une année sur l'autre tient davantage au hasard de l'échantillon qu'au marché.
        </p>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {[
            { heading: 'Les plus fortes hausses', list: trends.rising },
            { heading: 'Les plus fortes baisses', list: trends.falling },
          ].map((block) => (
            <div class="rounded-xl border border-hairline bg-surface p-6">
              <h3 class="text-base font-semibold">{block.heading}</h3>
              <ol class="mt-4 space-y-1">
                {block.list.map((entry) => (
                  <li class="flex items-baseline justify-between gap-3 border-b border-hairline py-2 text-sm last:border-0">
                    <a
                      class="font-medium underline decoration-brand-300 underline-offset-4 hover:text-brand-600"
                      href={`/prix-immobilier-${entry.commune.slug}`}
                    >
                      {entry.commune.name}
                    </a>
                    <span
                      class="flex shrink-0 items-baseline gap-1 font-medium tabular"
                      style={`color:${entry.ratio >= 0 ? 'var(--color-up)' : 'var(--color-down)'}`}
                    >
                      <span aria-hidden="true">{entry.ratio >= 0 ? '↑' : '↓'}</span>
                      {formatPercent(entry.ratio)}
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>

        <p class="mt-4 text-sm">
          À l'échelle du pays, voir où les prix ont le plus{' '}
          <a
            class="underline decoration-brand-300 underline-offset-2 hover:text-brand-600"
            href="/ou-les-prix-immobiliers-ont-le-plus-baisse"
          >
            baissé
          </a>{' '}
          et le plus{' '}
          <a
            class="underline decoration-brand-300 underline-offset-2 hover:text-brand-600"
            href="/ou-les-prix-immobiliers-ont-le-plus-augmente"
          >
            augmenté
          </a>.
        </p>
      </section>
    )
  }

  {
    districts.length > 0 && (
      <section class="mt-14">
        <h2 class="text-xl font-semibold">Prix par arrondissement</h2>
        <p class="mt-2 max-w-2xl text-sm text-ink-secondary">
          Les DVF ne connaissent pas {department.name} comme une commune unique : chaque
          arrondissement y est un territoire à part, avec ses propres ventes.
        </p>
        <ul class="mt-6 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {districts.map((district) => {
            const type = publishedTypes(district)[0]
            return (
              <li>
                <a
                  href={`/prix-immobilier-${district.slug}`}
                  class="flex items-baseline justify-between gap-3 rounded-lg border border-hairline bg-surface px-4 py-3 text-sm transition-colors hover:border-brand-300 hover:bg-brand-100"
                >
                  <span class="font-medium">{district.name}</span>
                  <span class="shrink-0 text-ink-secondary tabular">
                    {formatPricePerSqm(district.recent[type].pricePerSqm)}
                  </span>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    )
  }

  <h2 class="mt-14 text-xl font-semibold">Toutes les communes du département</h2>

  <div class="mt-6 overflow-x-auto rounded-lg border border-hairline bg-surface">
    <table class="w-full text-sm">
      <caption class="sr-only">
        Prix médian au mètre carré par commune, sur 24 mois
      </caption>
      <thead class="bg-surface-sunk text-xs text-ink-secondary">
        <tr>
          <th scope="col" class="px-4 py-2.5 text-left font-medium">Commune</th>
          <th scope="col" class="px-4 py-2.5 text-right font-medium">Appartement</th>
          <th scope="col" class="px-4 py-2.5 text-right font-medium">Maison</th>
          <th scope="col" class="px-4 py-2.5 text-right font-medium">Ventes</th>
        </tr>
      </thead>
      <tbody>
        {
          communes.map((commune) => (
            <tr class="border-t border-hairline">
              <th scope="row" class="px-4 py-2.5 text-left font-medium">
                <a
                  class="underline decoration-brand-300 underline-offset-2 hover:text-brand-600"
                  href={`/prix-immobilier-${commune.slug}`}
                >
                  {commune.name}
                </a>
              </th>
              <td class="px-4 py-2.5 text-right">{cell(commune, 'apartment')}</td>
              <td class="px-4 py-2.5 text-right">{cell(commune, 'house')}</td>
              <td class="px-4 py-2.5 text-right text-ink-secondary">
                {formatCount(
                  publishedTypes(commune).reduce((sum, type) => sum + commune.recent[type].count, 0)
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-2 text-xs text-ink-muted">
    « — » signale un type de bien comptant moins de 50 ventes sur 24 mois, trop peu pour publier
    une médiane.
  </p>

  <div class="mb-14">
    <Faq items={faq} />
  </div>
</Base>
