---
import Base from '../layouts/Base.astro'
import { allCommunes, publishedTypes } from '../lib/communes.js'
import { departments } from '../lib/departments.js'
import { groupByRegion } from '../lib/regions.js'
import { cheapest, dearest, trends } from '../lib/rankings.js'
import { roomHubPath, roomHubs, roomLeaderboard } from '../lib/rooms.js'
import {
  formatCount,
  formatPercentMagnitude,
  formatPricePerSqm,
  roomLabel,
} from '../lib/format.js'
import { DATASET } from '../lib/dataset.js'

const regions = groupByRegion(departments)

// The largest markets carry most of the search demand, and they give the page
// somewhere obvious to click before the region lists.
const salesOf = (commune) =>
  publishedTypes(commune).reduce((sum, type) => sum + commune.recent[type].count, 0)

const biggestCities = allCommunes
  .filter((commune) => commune.kind !== 'arrondissement')
  .sort((a, b) => salesOf(b) - salesOf(a))
  .slice(0, 24)
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'))

// The national rankings, each carrying the figure that makes it worth a click.
// They are the one thing here a search summary cannot reproduce without the
// underlying data — it takes 3 630 medians to rank the cheapest communes of
// France — so they sit above the browse lists rather than below them.
const houseTrends = trends('house')
const rankings = [
  {
    href: '/villes-les-plus-cheres-de-france',
    label: 'Les villes les plus chères',
    figure: (() => {
      const top = dearest('apartment', 1)[0]
      return `${top.name}, ${formatPricePerSqm(top.recent.apartment.pricePerSqm)}`
    })(),
    note: "Le haut du classement, appartements et maisons.",
  },
  {
    href: '/villes-les-moins-cheres-de-france',
    label: 'Les villes les moins chères',
    figure: (() => {
      const low = cheapest('apartment', 1)[0]
      return `${low.name}, ${formatPricePerSqm(low.recent.apartment.pricePerSqm)}`
    })(),
    note: 'Là où le mètre carré coûte le moins cher.',
  },
  {
    href: '/ou-les-prix-immobiliers-ont-le-plus-baisse',
    label: `Où les prix ont baissé en ${houseTrends.to}`,
    figure: `${formatPercentMagnitude(houseTrends.fallingShare)} des communes`,
    note: `Le prix des maisons y a reculé entre ${houseTrends.from} et ${houseTrends.to}.`,
  },
  {
    href: '/ou-les-prix-immobiliers-ont-le-plus-augmente',
    label: `Où les prix ont augmenté en ${houseTrends.to}`,
    figure: `${formatPercentMagnitude(houseTrends.risingShare)} des communes`,
    note: 'Le prix des maisons y a progressé sur la même période.',
  },
]

const title = 'Prix immobilier en France, commune par commune'
const description = `Le prix au m² de ${formatCount(allCommunes.length)} communes françaises, calculé sur les ventes enregistrées par l'administration fiscale entre 2021 et 2025.`

// The homepage carries the site-level markup the inner pages inherit context
// from. No SearchAction: the search box filters a local index and produces no
// crawlable results URL, so declaring one would describe an endpoint that does
// not exist.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: DATASET.siteName,
  url: Astro.site.href,
  inLanguage: 'fr-FR',
  description,
  license: DATASET.licenseUrl,
  isBasedOn: DATASET.sourceUrl,
}
---

<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <section class="py-6 sm:py-10">
    <h1 class="max-w-3xl text-4xl font-semibold sm:text-5xl">
      Combien coûte un logement dans votre commune ?
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-secondary">
      Le prix au mètre carré de
      <strong class="font-semibold text-ink">{formatCount(allCommunes.length)} communes</strong>,
      calculé à partir des ventes enregistrées par l'administration fiscale entre 2021 et 2025.
      Pas des estimations d'agence : des actes signés.
    </p>

    <div class="mt-8 max-w-xl">
      <label for="commune-search" class="block text-sm font-medium">
        Chercher une commune
      </label>
      <input
        id="commune-search"
        type="search"
        autocomplete="off"
        placeholder="Bordeaux, Lyon 3e, Saint-Malo…"
        class="mt-2 w-full rounded-lg border border-baseline bg-surface px-4 py-3 text-base shadow-[0_1px_2px_rgba(28,24,21,0.04)] transition-colors placeholder:text-ink-muted hover:border-brand-300 focus:border-brand-500 focus:outline-none focus-visible:outline-none"
      />
      <div id="search-status" class="sr-only" role="status" aria-live="polite"></div>
      <ul id="search-results" class="mt-3 space-y-1 empty:mt-0"></ul>
      <p id="search-empty" class="mt-3 hidden text-sm text-ink-muted">
        Aucune commune de ce nom. Elle compte peut-être moins de 50 ventes sur deux ans, le seuil
        en dessous duquel aucun prix n'est publié.
      </p>
    </div>
  </section>

  <section class="mt-14 border-t border-hairline pt-10">
    <h2 class="text-xl font-semibold">Les classements</h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-secondary">
      Ce qu'aucune page de commune ne peut montrer : les mêmes médianes, comparées d'un bout à
      l'autre du pays.
    </p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2">
      {
        rankings.map((ranking) => (
          <li>
            <a
              href={ranking.href}
              class="flex h-full flex-col rounded-xl border border-hairline bg-surface p-5 transition-colors hover:border-brand-300 hover:bg-brand-100"
            >
              <span class="text-sm font-semibold">{ranking.label}</span>
              <span class="mt-3 text-lg font-semibold text-brand-600 tabular">
                {ranking.figure}
              </span>
              <span class="mt-1 text-xs text-ink-secondary">{ranking.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* The hubs are the only route into the 149 typology pages that does not go
      through a commune page first — without this section a visitor asking « et
      un T3, ça vaut combien » has nowhere to start. */}
  <section class="mt-14 border-t border-hairline pt-10">
    <h2 class="text-xl font-semibold">Par typologie</h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-secondary">
      Le prix d'un appartement selon son nombre de pièces, dans les villes où il s'en vend assez
      pour que le chiffre tienne.
    </p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-3">
      {
        roomHubs.map((rooms) => {
          const board = roomLeaderboard(rooms)
          const middle = board[Math.floor((board.length - 1) / 2)]
          return (
            <li>
              <a
                href={roomHubPath(rooms)}
                class="flex h-full flex-col rounded-xl border border-hairline bg-surface p-5 transition-colors hover:border-brand-300 hover:bg-brand-100"
              >
                <span class="text-sm font-semibold">
                  Prix d'un {roomLabel(rooms, 'apartment')} par ville
                </span>
                <span class="mt-3 text-lg font-semibold text-brand-600 tabular">
                  {formatPricePerSqm(middle.cell.pricePerSqm)}
                </span>
                <span class="mt-1 text-xs text-ink-secondary">
                  Au milieu de {board.length} villes, de{' '}
                  {formatPricePerSqm(board.at(-1).cell.pricePerSqm)} à{' '}
                  {formatPricePerSqm(board[0].cell.pricePerSqm)}.
                </span>
              </a>
            </li>
          )
        })
      }
    </ul>
  </section>

  <section class="mt-14 border-t border-hairline pt-10">
    <h2 class="text-xl font-semibold">Les plus grandes villes</h2>
    <ul class="mt-5 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        biggestCities.map((commune) => (
          <li class="flex items-baseline justify-between gap-3 border-b border-hairline py-2 text-sm">
            <a
              class="font-medium underline decoration-brand-300 underline-offset-4 hover:text-brand-600"
              href={`/prix-immobilier-${commune.slug}`}
            >
              {commune.name}
            </a>
            <span class="shrink-0 text-ink-secondary tabular">
              {formatPricePerSqm(commune.recent[publishedTypes(commune)[0]].pricePerSqm)}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14 border-t border-hairline pt-10">
    <h2 class="text-xl font-semibold">Tous les départements</h2>
    <p class="mt-2 text-sm text-ink-secondary">
      Le chiffre de droite est le nombre de ventes retenues dans le département sur les 24 derniers
      mois.
    </p>

    <div class="mt-8 space-y-10">
      {
        regions.map((region) => (
          <div>
            <h3 class="text-sm font-semibold text-ink-secondary">{region.name}</h3>
            <ul class="mt-3 grid gap-x-8 gap-y-1 sm:grid-cols-2 lg:grid-cols-3">
              {region.departments.map((department) => (
                <li class="flex items-baseline justify-between gap-3 border-b border-hairline py-2 text-sm">
                  <a
                    class="underline decoration-hairline underline-offset-4 hover:text-brand-600 hover:decoration-brand-300"
                    href={`/prix-immobilier-departement-${department.slug}`}
                  >
                    {department.name}
                    <span class="ml-1.5 text-xs text-ink-muted tabular">{department.code}</span>
                  </a>
                  <span class="shrink-0 text-xs text-ink-muted tabular">
                    {formatCount(department.sales)}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mt-14 rounded-xl border border-hairline bg-surface p-6 sm:p-8">
    <h2 class="text-xl font-semibold">Ce que vous ne trouverez pas ici</h2>
    <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink-secondary">
      <li>
        <strong class="font-medium text-ink">Les communes de moins de 50 ventes.</strong> En deçà,
        la marge d'erreur dépasse 10 %. Afficher le chiffre reviendrait à inventer une précision
        qui n'existe pas.
      </li>
      <li>
        <strong class="font-medium text-ink">Le Bas-Rhin, le Haut-Rhin, la Moselle et Mayotte.</strong>
        Ces quatre départements relèvent du livre foncier et ne figurent pas dans les données
        ouvertes.
      </li>
      <li>
        <strong class="font-medium text-ink">Les ventes une par une.</strong> La loi interdit de les
        exposer. Seuls des agrégats communaux sont publiés.
      </li>
    </ul>
  </section>
</Base>

<script>
  // Progressive enhancement: without JS the region lists below are the way in,
  // so the search box simply stays inert rather than breaking the page.
  const input = document.querySelector('#commune-search')
  const results = document.querySelector('#search-results')
  const empty = document.querySelector('#search-empty')
  const status = document.querySelector('#search-status')

  const MAX_RESULTS = 8
  let index = null
  let pending = null

  const load = () =>
    (pending ??= fetch(
      `/search-index.json?v=${document.documentElement.dataset.datasetVersion}`
    ).then((r) => r.json()))

  // Must match the `q` field built in search-index.json.js: separators are
  // dropped, so a hyphen is optional everywhere.
  const normalise = (value) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase()
      .replace(/[^a-z0-9]/g, '')

  const render = (matches, query) => {
    results.replaceChildren()
    empty.classList.toggle('hidden', matches.length > 0 || query.length < 2)

    for (const match of matches) {
      const item = document.createElement('li')
      const link = document.createElement('a')
      // Typology entries carry their own address; everything else is a commune.
      link.href = match.u ?? `/prix-immobilier-${match.s}`
      link.className =
        'flex items-baseline justify-between gap-3 rounded-lg border border-hairline bg-surface px-4 py-3 text-sm transition-colors hover:border-brand-300 hover:bg-brand-100'

      const name = document.createElement('span')
      name.className = 'font-medium'
      name.textContent = match.n
      const dept = document.createElement('span')
      dept.className = 'ml-1.5 text-xs text-ink-muted'
      dept.textContent = match.d
      name.append(dept)

      const price = document.createElement('span')
      price.className = 'shrink-0 text-ink-secondary'
      price.textContent = `${match.p.toLocaleString('fr-FR')} €/m²`

      link.append(name, price)
      item.append(link)
      results.append(item)
    }

    // « résultat » rather than « commune » since the index now also holds
    // typology pages, which are not communes.
    status.textContent =
      query.length < 2
        ? ''
        : matches.length === 0
          ? 'Aucun résultat.'
          : `${matches.length} résultat${matches.length > 1 ? 's' : ''} proposé${matches.length > 1 ? 's' : ''}.`
  }

  const search = async () => {
    const query = normalise(input.value)
    if (query.length < 2) {
      render([], query)
      return
    }

    index ??= await load()
    // Three tiers, each ordered by sale volume. Without the tiers the exact
    // Saint-Denis ranks below Saint-Denis-lès-Bourg; without the volume sort
    // results come out in INSEE code order, which means nothing to a reader.
    const exact = []
    const prefix = []
    const inner = []
    // `a` is the typology entries' reversed key — « bordeauxt3 » as well as
    // « t3bordeaux » — so neither word order comes up empty.
    const tier = (entry) => {
      for (const key of [entry.q, entry.a]) {
        if (!key) continue
        if (key === query) return exact
        if (key.startsWith(query)) return prefix
        if (key.includes(query)) return inner
      }
      return null
    }
    for (const commune of index) tier(commune)?.push(commune)
    const byVolume = (a, b) => b.v - a.v
    const matches = [exact.sort(byVolume), prefix.sort(byVolume), inner.sort(byVolume)].flat()
    render(matches.slice(0, MAX_RESULTS), query)
  }

  input.addEventListener('focus', load, { once: true })
  input.addEventListener('input', search)
</script>
