---
import Base from '../layouts/Base.astro'
import { allCommunes } from '../lib/communes.js'
import { departments } from '../lib/departments.js'
import { formatCount } from '../lib/format.js'

const totalCommunes = allCommunes.length
const missing = ['Bas-Rhin', 'Haut-Rhin', 'Moselle', 'Mayotte']

const title = 'Prix immobilier en France, commune par commune | donnees-immo.fr'
const description = `Prix médian au m² pour ${formatCount(totalCommunes)} communes françaises, calculé sur les ventes réellement enregistrées entre 2021 et 2025. Source DVF (DGFiP), accès libre.`
---

<Base title={title} description={description}>
  <h1 class="text-3xl font-semibold sm:text-4xl">Prix immobilier, commune par commune</h1>

  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-secondary">
    Le prix médian au mètre carré de
    <strong class="font-semibold text-ink">{formatCount(totalCommunes)} communes</strong>, calculé
    à partir des <strong class="font-semibold text-ink">4 millions de ventes</strong> enregistrées
    par l'administration fiscale entre 2021 et 2025. Ce sont des transactions réelles, pas des
    estimations d'agence.
  </p>

  <section class="mt-10">
    <h2 class="text-base font-semibold">Choisir un département</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        departments.map((department) => (
          <li>
            <a
              href={`/prix-immobilier-departement-${department.slug}`}
              class="flex items-baseline justify-between gap-3 rounded-lg border border-hairline bg-surface px-4 py-3 text-sm transition-colors hover:border-brand-300 hover:bg-brand-100"
            >
              <span>
                <span class="font-medium">{department.name}</span>
                <span class="ml-1.5 text-xs text-ink-muted tabular">{department.code}</span>
              </span>
              <span class="shrink-0 text-xs text-ink-secondary tabular">
                {formatCount(department.communes.length)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10 rounded-xl border border-hairline bg-surface p-6">
    <h2 class="text-base font-semibold">Ce que vous ne trouverez pas ici</h2>
    <ul class="mt-3 space-y-2 text-sm text-ink-secondary">
      <li>
        <strong class="font-medium text-ink">Les communes de moins de 50 ventes.</strong> En deçà,
        la marge d'erreur sur la médiane dépasse 10 %. Publier le chiffre reviendrait à inventer
        une précision qui n'existe pas.
      </li>
      <li>
        <strong class="font-medium text-ink">Quatre départements.</strong> {missing.join(', ')} ne
        figurent pas dans les données ouvertes DVF : ils relèvent du livre foncier, un régime
        distinct.
      </li>
      <li>
        <strong class="font-medium text-ink">Les transactions individuelles.</strong> La loi
        interdit de les exposer commune par commune. Seuls des agrégats sont publiés.
      </li>
    </ul>
  </section>
</Base>
