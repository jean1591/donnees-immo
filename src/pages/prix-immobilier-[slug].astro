---
import Base from '../layouts/Base.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import StatTile from '../components/StatTile.astro'
import PriceChart from '../components/PriceChart.astro'
import YearlyTable from '../components/YearlyTable.astro'
import PriceRange from '../components/PriceRange.astro'
import RoomsTable from '../components/RoomsTable.astro'
import {
  allCommunes,
  arrondissements,
  comparables,
  evolution,
  parentCity,
  publishedTypes,
} from '../lib/communes.js'
import {
  agree,
  formatCount,
  formatEuro,
  formatPercentMagnitude,
  formatPricePerSqm,
  formatPricePerSqmProse,
  locative,
  TYPE_LABELS,
} from '../lib/format.js'

export function getStaticPaths() {
  return allCommunes.map((commune) => ({ params: { slug: commune.slug }, props: { commune } }))
}

const { commune } = Astro.props
const types = publishedTypes(commune)
const lead = commune.recent[types[0]]
const leadLabel = TYPE_LABELS[types[0]]
const leadTrend = evolution(commune, types[0], 1)

const totalSales = types.reduce((sum, type) => sum + commune.recent[type].count, 0)
const lastYear = commune.yearly.at(-1).year
const where = locative(commune.name)

const children = arrondissements(commune)
const city = parentCity(commune)
const nearby = commune.kind === 'arrondissement' ? null : comparables(commune)

// The site name is left out: Google appends it from og:site_name, and the
// characters are better spent on the figure. The price is only kept when the
// whole title still fits the ~60 characters a result actually shows —
// "Saint-Laurent-de-la-Cabrerisse" alone eats half the budget.
const titleBase = `Prix immobilier ${where} (${commune.department.code})`
const titleWithPrice = `${titleBase} — ${formatPricePerSqm(lead.pricePerSqm)}`
const title = titleWithPrice.length <= 60 ? titleWithPrice : titleBase
// Kept under ~155 characters so Google shows it whole, even for the longest
// commune names in the dataset.
const description = `Prix immobilier ${where} : ${formatPricePerSqm(lead.pricePerSqm)} pour ${leadLabel.article} ${leadLabel.singular}, ${formatEuro(lead.medianPrice)} en prix de vente. Médianes sur ${formatCount(totalSales)} ventes enregistrées (DVF).`

// Dataset markup: the page exposes a sourced, dated statistic, which is what
// makes it citable by search engines and language models.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Prix immobilier ${where}`,
  description,
  license: 'https://www.etalab.gouv.fr/licence-ouverte-open-licence',
  creator: { '@type': 'GovernmentOrganization', name: 'DGFiP' },
  temporalCoverage: `${commune.yearly[0].year}/${lastYear}`,
  spatialCoverage: { '@type': 'Place', name: commune.name },
  isBasedOn:
    'https://www.data.gouv.fr/datasets/demandes-de-valeurs-foncieres-geolocalisees',
  variableMeasured: types.map((type) => ({
    '@type': 'PropertyValue',
    name: `Prix médian au m² — ${TYPE_LABELS[type].plural}`,
    value: commune.recent[type].pricePerSqm,
    unitText: 'EUR/m²',
    measurementTechnique: `Médiane sur ${formatCount(commune.recent[type].count)} ventes, 24 mois glissants`,
  })),
}
---

<Base title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <Breadcrumb
    items={[
      { label: 'Accueil', href: '/' },
      { label: commune.department.name, href: `/prix-immobilier-departement-${commune.department.slug}` },
      ...(city ? [{ label: city.name, href: `/prix-immobilier-${city.slug}` }] : []),
      { label: commune.name },
    ]}
  />

  <h1 class="mt-5 text-3xl font-semibold sm:text-4xl">
    Prix immobilier {where}
  </h1>

  <p class="mt-5 max-w-2xl text-xl leading-relaxed">
    {where.charAt(0).toUpperCase() + where.slice(1)}, {leadLabel.article} {leadLabel.singular} se
    vend <strong class="font-semibold">{formatEuro(lead.medianPrice)}</strong>, soit
    <strong class="font-semibold">{formatPricePerSqmProse(lead.pricePerSqm)}</strong>.
  </p>

  <p class="mt-4 max-w-2xl leading-relaxed text-ink-secondary">
    C'est le prix médian des {formatCount(lead.count)} {leadLabel.plural} vendu{agree(types[0])}s
    ces deux dernières années : la moitié sont parti{agree(types[0])}s au-dessus de ce prix, l'autre
    moitié en dessous.
    {
      leadTrend && (
        <>
          {' '}Le prix au mètre carré a {leadTrend.ratio >= 0 ? 'augmenté' : 'reculé'} de{' '}
          <strong class="font-medium text-ink">{formatPercentMagnitude(leadTrend.ratio)}</strong>{' '}
          entre {leadTrend.from} et {leadTrend.to}.
        </>
      )
    }
  </p>

  <div class:list={['mt-10 grid gap-4', types.length > 1 && 'md:grid-cols-2']}>
    {types.map((type) => <StatTile commune={commune} type={type} />)}
  </div>

  {
    types.length === 1 && (
      <p class="mt-4 text-sm text-ink-muted">
        Les ventes de {TYPE_LABELS[types[0] === 'apartment' ? 'house' : 'apartment'].plural} sont
        trop peu nombreuses {where} pour publier une médiane fiable.
      </p>
    )
  }

  <PriceChart yearly={commune.yearly} types={types} />
  <YearlyTable yearly={commune.yearly} types={types} />

  <PriceRange commune={commune} types={types} />

  <RoomsTable rooms={commune.rooms} types={types} />

  {
    children.length > 0 && (
      <section class="my-14">
        <h2 class="text-xl font-semibold">Prix par arrondissement</h2>
        <p class="mt-1 text-sm text-ink-secondary">
          Les chiffres {where} sont recalculés sur l'ensemble des ventes, et non moyennés à partir
          des arrondissements.
        </p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {children.map((child) => {
            const type = publishedTypes(child)[0]
            return (
              <li>
                <a
                  href={`/prix-immobilier-${child.slug}`}
                  class="flex items-baseline justify-between gap-3 rounded-lg border border-hairline bg-surface px-4 py-3 text-sm transition-colors hover:border-brand-300 hover:bg-brand-100"
                >
                  <span class="font-medium">{child.name.replace(`${commune.name} `, '')}</span>
                  <span class="text-ink-secondary tabular">
                    {formatPricePerSqm(child.recent[type].pricePerSqm)}
                  </span>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    )
  }

  {
    nearby && nearby.list.length > 0 && (
      <section class="my-14">
        {/* Department names carry no gender or article in the dataset, so the
            heading avoids the preposition rather than guessing it. */}
        <h2 class="text-xl font-semibold">Communes au prix comparable</h2>
        <p class="mt-1 text-sm text-ink-secondary">
          Les communes du département qui encadrent {commune.name} sur le prix médian au m², pour
          les {TYPE_LABELS[nearby.type].plural}.
        </p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {nearby.list.map((other) => (
            <li>
              <a
                href={`/prix-immobilier-${other.slug}`}
                class="flex items-baseline justify-between gap-3 rounded-lg border border-hairline bg-surface px-4 py-3 text-sm transition-colors hover:border-brand-300 hover:bg-brand-100"
              >
                <span class="font-medium">{other.name}</span>
                <span class="text-ink-secondary tabular">
                  {formatPricePerSqm(other.recent[nearby.type].pricePerSqm)}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-sm">
          <a
            class="underline decoration-brand-300 underline-offset-2 hover:text-brand-600"
            href={`/prix-immobilier-departement-${commune.department.slug}`}
          >
            Voir tout le département {commune.department.name} ({commune.department.code})
          </a>
        </p>
      </section>
    )
  }

  <section class="my-14 rounded-xl border border-hairline bg-surface p-6 sm:p-8">
    <h2 class="text-xl font-semibold">Comment ces chiffres sont calculés</h2>
    <ul class="mt-3 space-y-2 text-sm text-ink-secondary">
      <li>
        <strong class="font-medium text-ink">Des ventes, pas des estimations.</strong> Chaque chiffre
        vient des actes notariés transmis à l'administration fiscale.
      </li>
      <li>
        <strong class="font-medium text-ink">Médiane, pas moyenne.</strong> La médiane résiste aux
        ventes atypiques, qui représentent environ 7 % des transactions.
      </li>
      <li>
        <strong class="font-medium text-ink">Ventes d'un seul logement.</strong> Les lots multiples,
        dépendances et parkings vendus seuls sont écartés.
      </li>
      <li>
        <strong class="font-medium text-ink">Seuil de publication à 50 ventes.</strong> En deçà, la
        marge d'erreur sur la médiane dépasse 10 % et le chiffre n'est pas publié.
      </li>
    </ul>
    <p class="mt-4 text-sm">
      <a class="font-medium text-brand-600 underline decoration-brand-300 underline-offset-2 hover:text-brand-700" href="/methodologie">
        Méthodologie détaillée
      </a>
    </p>
  </section>
</Base>
