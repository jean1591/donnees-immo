---
import Base from '../layouts/Base.astro'

const title = 'Page introuvable'
const description = "Cette page n'existe pas sur donnees-immo.fr."
---

<Base title={title} description={description}>
  <section class="py-10">
    <h1 class="text-3xl font-semibold sm:text-4xl">Cette page n'existe pas</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-secondary">
      Si vous cherchiez une commune, deux explications possibles : l'adresse est mal orthographiée,
      ou la commune compte moins de 50 ventes sur deux ans — en dessous de ce seuil, aucun prix
      n'est publié.
    </p>
    <p class="mt-6">
      <a
        class="inline-block rounded-lg bg-brand-500 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-brand-600"
        href="/">Chercher une commune</a
      >
    </p>
  </section>
</Base>
