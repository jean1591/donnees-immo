---
// City-versus-city comparison. Everything on this page is computed on the pair:
// the gap, what one budget buys in each, which of the two types leads where, the
// typology spread and the five-year divergence. A page that only stacked the two
// commune tables side by side would be duplication, and would put the 4 694
// pages around it at risk rather than adding to them — see lib/pairs.js.
import Base from '../layouts/Base.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import StatTile from '../components/StatTile.astro'
import { BUDGET, comparison, pairPath, pairs, pairsOf } from '../lib/pairs.js'
import {
  formatArea,
  formatCount,
  formatEuro,
  formatPercent,
  formatPercentMagnitude,
  formatPricePerSqm,
  formatPricePerSqmProse,
  locative,
  roomLabel,
  TYPE_LABELS,
} from '../lib/format.js'
import { roomPagePath } from '../lib/rooms.js'
import { DATASET, basedOn, creator, place, publisher, RECENT_WINDOW } from '../lib/dataset.js'

export function getStaticPaths() {
  return pairs.map(({ a, b }) => ({ params: { a: a.slug, b: b.slug }, props: { a, b } }))
}

const { a, b } = Astro.props
const data = comparison(a, b)
const lead = data.lead
const leadLabel = TYPE_LABELS[lead]
const leadGap = data.gaps[lead]

// Assembled here rather than as two adjacent expressions in the markup: Astro
// drops the literal space between `{article} {noun}` inside a fragment, which
// silently produced « pour unappartement » on all 45 pages.
const leadNoun = `${leadLabel.article} ${leadLabel.singular}`

const sentenceCase = (text) => text.charAt(0).toUpperCase() + text.slice(1)

// « 29,6 % de plus » carried separately from « à Bordeaux qu'à Toulouse » so the
// figure can be emphasised without splitting the sentence into a run of adjacent
// expressions, which is where the spaces get lost.
const gapPhrase = (type) => ({
  strong: `${formatPercentMagnitude(data.gaps[type].ratio)} de plus`,
  rest: `${locative(data.gaps[type].dearer.name)} qu'${locative(data.gaps[type].cheaper.name)}.`,
})

// Rust for the dearer side, green for the cheaper — the tokens the price
// evolutions already use, rather than a second red and a second green.
const DEARER = 'var(--color-up)'
const CHEAPER = 'var(--color-down)'

const totalSales = data.types.reduce(
  (sum, type) => sum + a.recent[type].count + b.recent[type].count,
  0
)
const lastYear = a.yearly.at(-1).year

// The square metres one budget buys in each city, which is the comparison a
// reader actually runs and neither commune page performs.
const area = (city) => Math.round(leadGap.area[city.code])

// The two cities rank their own types the same way or they do not. Where they
// differ, that difference is the page's own fact: among these ten, Lille is
// alone in following the national ordering, where the apartment leads.
const orderings = [data.ordering[a.code], data.ordering[b.code]]
const splitOrdering =
  orderings[0] && orderings[1] && orderings[0] !== orderings[1]
    ? { apartment: orderings[0] === 'apartment' ? a : b, house: orderings[0] === 'house' ? a : b }
    : null

const trends = data.trends

// Both long sentences are assembled as strings rather than as a run of adjacent
// expressions: the markup form loses the spaces between them, and these two read
// as prose, where a missing space is the first thing a reader sees.
const orderingSentence =
  splitOrdering &&
  `${sentenceCase(locative(splitOrdering.house.name))}, la maison coûte plus cher au m² que ` +
    `l'appartement — ${formatPricePerSqm(splitOrdering.house.recent.house.pricePerSqm)} contre ` +
    `${formatPricePerSqm(splitOrdering.house.recent.apartment.pricePerSqm)}. ` +
    `${sentenceCase(locative(splitOrdering.apartment.name))}, c'est l'inverse : ` +
    `${formatPricePerSqm(splitOrdering.apartment.recent.apartment.pricePerSqm)} pour l'appartement ` +
    `contre ${formatPricePerSqm(splitOrdering.apartment.recent.house.pricePerSqm)} pour la maison.`

const direction = (ratio) => (ratio >= 0 ? 'progressé' : 'reculé')

// « a reculé de 0,3 % à Lille et de 10,5 % à Paris » where both moved the same
// way, « a reculé de X à Lille, et progressé de Y à Toulouse » where they did
// not. Repeating the participle when it is the same word reads as a stutter.
const trendSentence =
  trends &&
  `Entre ${trends[a.code].from} et ${trends[a.code].to}, le prix au m² des ${leadLabel.plural} ` +
    `a ${direction(trends[a.code].ratio)} de ${formatPercentMagnitude(trends[a.code].ratio)} ` +
    `${locative(a.name)}` +
    (trends[a.code].ratio >= 0 === (trends[b.code].ratio >= 0)
      ? ` et de ${formatPercentMagnitude(trends[b.code].ratio)} ${locative(b.name)}.`
      : `, et ${direction(trends[b.code].ratio)} de ` +
        `${formatPercentMagnitude(trends[b.code].ratio)} ${locative(b.name)}.`) +
    // Stated only where the two trajectories actually parted: below five points
    // the gap is within what the yearly medians can carry.
    (trends.spread >= 0.05
      ? ` Les deux marchés ont donc divergé de ${formatPercentMagnitude(trends.spread)} sur la période.`
      : '') +
    // The national move over the same five years. Without it a local figure has
    // nothing to be read against: two cities both up 13 % is a national tide,
    // one city down 10 % while the country is up 7 % is a local story.
    (data.nationalTrend
      ? ` Sur la même période, la France entière a ${direction(data.nationalTrend.ratio)} de ` +
        `${formatPercentMagnitude(data.nationalTrend.ratio)}.`
      : '')

const title = `${a.name} ou ${b.name} : prix immobilier comparés`
const description = `${a.name} ou ${b.name} ? ${formatPricePerSqm(a.recent[lead].pricePerSqm)} contre ${formatPricePerSqm(b.recent[lead].pricePerSqm)} pour ${leadLabel.article} ${leadLabel.singular}. Comparaison sur ${formatCount(totalSales)} ventes réelles (DVF).`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `Prix immobilier comparés : ${a.name} et ${b.name}`,
  description,
  license: DATASET.licenseUrl,
  creator,
  publisher: publisher(Astro.site),
  dateModified: DATASET.releaseDate,
  temporalCoverage: `${a.yearly[0].year}/${lastYear}`,
  // Two places, because the figures describe two markets. A single Place naming
  // both would put coordinates on a point that is neither.
  spatialCoverage: [place(a.name, a.geo), place(b.name, b.geo)],
  isBasedOn: basedOn,
  variableMeasured: data.types.flatMap((type) =>
    [a, b].map((city) => ({
      '@type': 'PropertyValue',
      name: `Prix médian au m² — ${TYPE_LABELS[type].plural}, ${city.name}`,
      value: city.recent[type].pricePerSqm,
      unitText: 'EUR/m²',
      measurementTechnique: `Médiane sur ${formatCount(city.recent[type].count)} ventes, 24 mois glissants`,
    }))
  ),
}
---

<Base title={title} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />

  <Breadcrumb
    items={[
      { label: 'Accueil', href: '/' },
      { label: a.name, href: `/prix-immobilier-${a.slug}` },
      { label: `${a.name} ou ${b.name}` },
    ]}
  />

  <h1 class="mt-5 text-3xl font-semibold sm:text-4xl">
    Prix immobilier : {a.name} ou {b.name} ?
  </h1>

  <p class="mt-5 max-w-2xl text-xl leading-relaxed">
    {
      leadGap.ratio < 0.01 ? (
        <>
          Les deux villes sont au même prix : {formatPricePerSqmProse(a.recent[lead].pricePerSqm)}
          {' '}{locative(a.name)}, {formatPricePerSqmProse(b.recent[lead].pricePerSqm)}{' '}
          {locative(b.name)} pour {leadNoun}.
        </>
      ) : (
        <>
          {leadGap.dearer.name} coûte{' '}
          <strong class="font-semibold">{formatPercentMagnitude(leadGap.ratio)} de plus</strong>{' '}
          que {leadGap.cheaper.name} :{' '}
          {formatPricePerSqmProse(leadGap.dearer.recent[lead].pricePerSqm)} contre{' '}
          {formatPricePerSqmProse(leadGap.cheaper.recent[lead].pricePerSqm)} pour {leadNoun}.
        </>
      )
    }
  </p>

  <p class="mt-4 max-w-2xl leading-relaxed text-ink-secondary">
    Médianes calculées sur {formatCount(a.recent[lead].count)} {leadLabel.plural} vendus{' '}
    {locative(a.name)} et {formatCount(b.recent[lead].count)} {locative(b.name)},{' '}
    {RECENT_WINDOW.between}. Ce sont des prix de vente enregistrés par l'administration fiscale,
    pas des prix affichés dans les annonces.
  </p>

  <section class="mt-14">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-muted">
      Ce que {formatEuro(BUDGET)} achètent
    </h2>
    {
      area(leadGap.cheaper) - area(leadGap.dearer) > 0 && (
        <p class="mt-2 max-w-2xl text-2xl leading-snug tracking-tight sm:text-3xl">
          <strong class="font-semibold text-brand-600">
            {`${formatArea(area(leadGap.cheaper) - area(leadGap.dearer))} de plus ${locative(leadGap.cheaper.name)}`}
          </strong>{' '}
          <span class="text-ink-secondary">pour le même budget.</span>
        </p>
      )
    }
    <p class="mt-2 text-sm text-ink-secondary">
      À la médiane du m², pour {leadNoun}.
    </p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        [a, b].map((city) => (
          <div class="rounded-xl border border-hairline bg-surface p-6">
            <p class="text-sm font-semibold">{city.name}</p>
            <p class="mt-2 text-4xl font-semibold tracking-tight text-brand-600 tabular">
              {formatArea(area(city))}
            </p>
            <p class="mt-2 text-sm text-ink-secondary">
              soit {formatPricePerSqm(city.recent[lead].pricePerSqm)}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  {
    data.types.map((type) => (
      <section class="mt-14">
        {/* The type is the label and the gap is the statement, not the reverse:
            two lines of similar weight left the reader deciding which to read
            first. The tiles below already name the type in the same colour, so
            the heading has no size to justify — only an outline to hold. */}
        <h2 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-ink-muted">
          <span
            class="inline-block h-2 w-2 rounded-full"
            style={`background:var(--color-series-${type === 'apartment' ? 'apartment' : 'house'})`}
            aria-hidden="true"
          />
          {TYPE_LABELS[type].title}
        </h2>
        <p class="mt-2 max-w-2xl text-2xl leading-snug tracking-tight sm:text-3xl">
          <strong class="font-semibold" style={`color:${DEARER}`}>
            {gapPhrase(type).strong}
          </strong>{' '}
          <span class="text-ink-secondary">{gapPhrase(type).rest}</span>
        </p>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <StatTile commune={a} type={type} label={a.name} />
          <StatTile commune={b} type={type} label={b.name} />
        </div>
      </section>
    ))
  }

  {
    splitOrdering && (
      <section class="my-14 rounded-xl border border-hairline bg-surface p-6">
        <h2 class="text-xl font-semibold">Les deux villes ne se classent pas pareil</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-ink-secondary">
          {orderingSentence}
        </p>
        <p class="mt-3 max-w-2xl text-sm text-ink-muted">
          Le classement national place l'appartement devant, mais il s'inverse dans la plupart des
          villes prises une à une : les maisons qui se vendent dans une grande ville sont rarement
          celles de sa périphérie.
        </p>
      </section>
    )
  }

  {
    data.rooms.length > 0 && (
      <section class="my-14">
        <h2 class="text-xl font-semibold">Par typologie</h2>
        <p class="mt-1 text-sm text-ink-secondary">
          Prix médian au m² des appartements, par nombre de pièces. Chaque cellule repose sur au
          moins 100 ventes, et l'écart se lit toujours du point de vue de {a.name}.
        </p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[32rem] border-collapse text-sm">
            <thead>
              <tr class="border-b border-hairline text-left">
                <th class="py-2 pr-4 font-medium"> </th>
                <th class="py-2 pr-4 font-medium">{a.name}</th>
                <th class="py-2 pr-4 font-medium">{b.name}</th>
                <th class="py-2 font-medium">Écart pour {a.name}</th>
              </tr>
            </thead>
            <tbody>
              {data.rooms.map((row) => (
                <tr class="border-b border-hairline last:border-0">
                  <th class="py-2 pr-4 text-left font-medium">
                    <a
                      href={roomPagePath(a, row.rooms)}
                      class="underline decoration-hairline underline-offset-2 hover:text-brand-600"
                    >
                      {roomLabel(row.rooms, 'apartment')}
                    </a>
                  </th>
                  <td class="py-2 pr-4 tabular">
                    {formatPricePerSqm(row.cells[a.code].pricePerSqm)}
                  </td>
                  <td class="py-2 pr-4 tabular">
                    {formatPricePerSqm(row.cells[b.code].pricePerSqm)}
                  </td>
                  <td class="py-2">
                    <span
                      class="font-semibold tabular"
                      style={`color:${row.fromFirst >= 0 ? DEARER : CHEAPER}`}
                    >
                      <span aria-hidden="true">{row.fromFirst >= 0 ? '↑' : '↓'}</span>{' '}
                      {formatPercentMagnitude(row.fromFirst)}
                    </span>{' '}
                    <span class="text-xs text-ink-muted">
                      {row.fromFirst >= 0 ? 'plus cher' : 'moins cher'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    trends && (
      <section class="my-14">
        <h2 class="text-xl font-semibold">Cinq ans de trajectoire</h2>
        <p class="mt-2 max-w-2xl leading-relaxed text-ink-secondary">
          {trendSentence}
        </p>
        <p class="mt-3 max-w-2xl text-sm text-ink-muted">
          Ces variations sont nominales. Sur la même période, les prix à la consommation ont
          progressé de 13,6 % (INSEE), ce qu'une hausse doit dépasser pour en être une.
        </p>
      </section>
    )
  }

  <section class="my-14">
    <h2 class="text-xl font-semibold">Aller au détail</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        [a, b].map((city) => (
          <li>
            <a
              href={`/prix-immobilier-${city.slug}`}
              class="block rounded-lg border border-hairline bg-surface px-4 py-3 text-sm font-medium transition-colors hover:border-brand-300 hover:bg-brand-100"
            >
              Prix immobilier {locative(city.name)}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="my-14">
    <h2 class="text-xl font-semibold">Comparer {a.name} à une autre ville</h2>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        pairsOf(a)
          .filter((other) => other.code !== b.code)
          .map((other) => (
            <li>
              <a
                href={pairPath(a, other)}
                class="block rounded-lg border border-hairline bg-surface px-4 py-3 text-sm transition-colors hover:border-brand-300 hover:bg-brand-100"
              >
                <span class="font-medium">
                  {a.name} ou {other.name}
                </span>
              </a>
            </li>
          ))
      }
    </ul>
  </section>
</Base>
