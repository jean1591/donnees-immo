---
import '../styles/global.css'
import { DATASET } from '../lib/dataset.js'

const { title, description, canonical } = Astro.props
const href = canonical ?? new URL(Astro.url.pathname, Astro.site).href

// One card for the whole site, generated by scripts/og-card.mjs. It carries the
// commune count, so it is regenerated with the ETL — hence the release stamp in
// the URL: social scrapers cache an image by address more or less forever, and
// without it a refreshed dataset would keep sharing the previous count.
const ogImage = new URL(`/og.png?v=${DATASET.releaseDate}`, Astro.site).href
---

<!doctype html>
<html lang="fr" data-dataset-version={DATASET.releaseDate}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={href} />

    {/* The .ico is listed first and the SVG second: browsers take the last
        format they understand, so modern ones get the SVG and the rest fall
        back. It mostly exists for the clients that never read this markup and
        request /favicon.ico at the root regardless — that was a steady source
        of 404s in the crawler logs. Both come from scripts/favicon.mjs.

        Still no apple-touch-icon: that one has to be a PNG, and pointing at a
        missing file is worse than declaring nothing. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf5ec" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={DATASET.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={href} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="donnees-immo.fr — prix immobilier commune par commune, d'après les ventes enregistrées"
    />
    {/* No twitter:image: X falls back to og:image, and a second address for
        the same file is a second thing to keep in step. */}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap.xml" />

    {/* Umami, self-hosted and cookieless — no consent banner needed, and
        nothing to declare beyond the line in /mentions-legales. `is:inline`
        keeps Astro from touching the tag; only the production build gets it,
        so `astro dev` does not pollute the stats. */}
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://analytics.rb2.fr/script.js"
          data-website-id="5a436819-bd68-44c4-9c05-46bfac0e2abe"
        />
      )
    }
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-plane text-ink antialiased">
    <header class="border-b border-hairline">
      <div class="mx-auto flex max-w-4xl items-baseline justify-between gap-4 px-4 py-5">
        <a href="/" class="text-base font-semibold tracking-tight hover:text-brand-600">
          {/* brand-600 rather than brand-500: as a letter the lighter step is
              at 3.37:1 against the cream. It stays brand-500 everywhere it is
              a fill — bars, dots, chips — where no contrast floor applies. */}
          donnees-immo<span class="text-brand-600">.fr</span>
        </a>
        <span class="text-xs text-ink-muted">Prix réels issus des ventes enregistrées</span>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-4 py-10 sm:py-14">
      <slot />
    </main>

    <footer class="mt-20 border-t border-hairline">
      <div class="mx-auto max-w-4xl space-y-3 px-4 py-10 text-xs leading-relaxed text-ink-secondary">
        <p>
          Source : <a
            class="underline decoration-brand-300 underline-offset-2 hover:text-brand-600"
            href={DATASET.sourceUrl}
            target="_blank"
            rel="noopener">Demandes de valeurs foncières géolocalisées</a
          >, DGFiP via Etalab — Licence Ouverte 2.0. Données arrêtées au {DATASET.coverageEnd}.
        </p>
        <p>
          Agrégats calculés commune par commune. Aucune transaction individuelle n'est publiée,
          conformément à l'article R*112 A-3 du livre des procédures fiscales.
        </p>
        <nav class="flex gap-4 pt-2">
          <a class="hover:text-brand-600" href="/methodologie">Méthodologie</a>
          <a class="hover:text-brand-600" href="/mentions-legales">Mentions légales</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
